<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>アニメ業界ヘッドライン</title>
<meta name="description" content="アニメ業界のニュースと現場の声を、1話ずつ。縦にめくって次の話、横にめくってくわしく。毎朝更新。">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Dela+Gothic+One&family=M+PLUS+1p:wght@500;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --paper:#f6f1e4; --paper2:#fffdf6; --ink:#16130f; --sub:#5d574c; --rule:#16130f;
  --red:#e5332a; --yellow:#ffd42a; --blue:#2f6fe4; --pink:#ff5d93;
  --accent:var(--red);
  --head:"Dela Gothic One","M PLUS 1p",system-ui,sans-serif;
  --body:"M PLUS 1p",system-ui,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;color-scheme:light}
body{
  font-family:var(--body);color:var(--ink);overflow:hidden;-webkit-font-smoothing:antialiased;
  background-color:var(--paper);
  background-image:radial-gradient(rgba(22,19,15,.09) 1px,transparent 1.3px);
  background-size:7px 7px;
}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
a{color:inherit}

/* ===== ヘッダー：雑誌の表紙帯 ===== */
header{position:fixed;inset:0 0 auto 0;z-index:20;background:var(--paper2);border-bottom:3px solid var(--rule)}
.mast{display:flex;align-items:stretch;justify-content:space-between}
.logo{display:flex;align-items:center;gap:8px;padding:8px 12px 6px 16px}
.logo b{font-family:var(--head);font-weight:400;font-size:17px;letter-spacing:.02em;line-height:1}
.logo b span{color:var(--red)}
.gou{font-size:11px;font-weight:800;background:var(--ink);color:var(--paper2);padding:3px 7px;border-radius:2px;white-space:nowrap}
.how{border-left:3px solid var(--rule);padding:0 14px;font-size:12px;font-weight:800;background:var(--yellow)}
.tabs{display:flex;gap:6px;padding:0 12px;overflow-x:auto;scrollbar-width:none;border-top:2px solid var(--rule);background:var(--paper)}
.tabs::-webkit-scrollbar{display:none}
.tabs button{font-size:12px;font-weight:800;white-space:nowrap;padding:7px 10px 6px;border:2px solid var(--rule);border-top:0;border-radius:0 0 8px 8px;background:var(--paper2);margin-bottom:-2px;transform:translateY(-1px)}
.tabs button i{font-style:normal;margin-left:4px;font-size:11px;color:var(--sub)}
.tabs button[aria-pressed=true]{background:var(--ink);color:var(--paper2)}
.tabs button[aria-pressed=true] i{color:var(--yellow)}

/* ===== 縦にめくる ===== */
main{height:100dvh;overflow-y:auto;scroll-snap-type:y mandatory;scrollbar-width:none}
main::-webkit-scrollbar{display:none}
.card{height:100dvh;scroll-snap-align:start;scroll-snap-stop:always;position:relative;padding:96px 14px 74px;display:flex}
.card[hidden]{display:none}

/* ===== 横にめくる（コマ） ===== */
.panels{flex:1;display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:6px 4px 10px}
.panels::-webkit-scrollbar{display:none}
.koma{
  flex:0 0 100%;scroll-snap-align:center;position:relative;
  background:var(--paper2);border:3px solid var(--rule);box-shadow:5px 5px 0 var(--rule);
  padding:22px 18px 18px;display:flex;flex-direction:column;gap:14px;justify-content:center;overflow:hidden;
}
.koma > *{position:relative}
.inner{max-width:560px;width:100%;margin:0 auto;display:flex;flex-direction:column;gap:14px}

/* 1コマ目：集中線 */
.koma.cover::before{
  content:"";position:absolute;inset:-40%;
  background:repeating-conic-gradient(from 0deg at 50% 52%, rgba(22,19,15,.07) 0deg 1.2deg, transparent 1.2deg 6deg);
  -webkit-mask:radial-gradient(circle at 50% 52%, transparent 22%, #000 60%);
          mask:radial-gradient(circle at 50% 52%, transparent 22%, #000 60%);
}
.ep{position:absolute;top:0;left:0;background:var(--ink);color:var(--paper2);font-family:var(--head);font-size:14px;padding:6px 12px 6px 10px;clip-path:polygon(0 0,100% 0,88% 100%,0 100%)}
.ep small{font-family:var(--body);font-weight:800;font-size:10px;margin-left:2px}
.stamp{align-self:flex-start;font-weight:800;font-size:12px;color:#fff;background:var(--accent);padding:4px 10px;border:2px solid var(--rule);transform:rotate(-3deg);box-shadow:2px 2px 0 var(--rule)}
.meta{display:flex;gap:6px;flex-wrap:wrap;font-size:11px;font-weight:700;color:var(--sub)}
.meta span{border:1.5px solid var(--sub);border-radius:99px;padding:1px 8px}
h2{font-family:var(--head);font-weight:400;font-size:clamp(25px,7.2vw,38px);line-height:1.32;word-break:keep-all;overflow-wrap:anywhere}
h2 em{font-style:normal;background:linear-gradient(transparent 58%,var(--yellow) 58%,var(--yellow) 92%,transparent 92%)}
.lead{font-size:15.5px;line-height:1.9;font-weight:500}
.src{font-size:11.5px;color:var(--sub);font-weight:700}
.src a{text-decoration:underline;text-underline-offset:3px}
.turn{align-self:flex-end;font-size:12px;font-weight:800;color:var(--accent)}
.turn::after{content:" ▶"}

/* ナレーション枠（ざっくり） */
.narr{background:var(--ink);color:var(--paper2);padding:14px 16px;font-size:16px;line-height:1.85;font-weight:700}
.label{font-family:var(--head);font-size:15px;display:flex;align-items:center;gap:8px}
.label::before{content:"";width:14px;height:14px;background:var(--accent);border:2px solid var(--rule);transform:rotate(45deg)}
.ptext{font-size:16px;line-height:1.95;font-weight:500}

/* 吹き出し（現場の声） */
.bubble{position:relative;background:#fff;border:3px solid var(--rule);border-radius:28px;padding:18px 18px;font-size:15.5px;line-height:1.85;font-weight:500}
.bubble::after{content:"";position:absolute;left:34px;bottom:-21px;width:26px;height:22px;background:#fff;border:3px solid var(--rule);border-top:0;border-right:0;transform:skewX(-28deg);clip-path:polygon(0 0,100% 0,0 100%)}
.bubble b{display:block;font-family:var(--head);font-weight:400;font-size:19px;margin-bottom:6px}
.speaker{margin-top:12px;display:flex;align-items:center;gap:10px}
.speaker .face{width:38px;height:38px;border-radius:50%;border:3px solid var(--rule);background:var(--accent);display:grid;place-items:center;font-family:var(--head);color:#fff;font-size:15px}
.speaker div{display:flex;flex-direction:column}
.speaker strong{font-size:14px}
.speaker span{font-size:11px;color:var(--sub);font-weight:700}
.note{font-size:10.5px;color:var(--sub);line-height:1.7}

/* コマ送りインジケータ・シェア */
.pages{position:absolute;left:34px;bottom:96px;display:flex;gap:4px}
.pages i{width:10px;height:10px;border:2px solid var(--rule);background:var(--paper2);transform:rotate(45deg)}
.pages i.on{background:var(--accent)}
.share{position:absolute;right:30px;bottom:94px;height:36px;padding:0 12px;border:2.5px solid var(--rule);background:var(--yellow);font-size:12px;font-weight:800;box-shadow:3px 3px 0 var(--rule)}
.share:active{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--rule)}

/* ===== フッター：次回予告 ===== */
footer{position:fixed;inset:auto 0 0 0;z-index:20;display:flex;justify-content:space-between;align-items:center;padding:8px 14px calc(8px + env(safe-area-inset-bottom));background:var(--paper2);border-top:3px solid var(--rule)}
.count{font-family:var(--head);font-size:20px;line-height:1}
.count small{font-family:var(--body);font-weight:800;font-size:12px;color:var(--sub);margin-left:2px}
.next{font-family:var(--head);font-size:15px;background:var(--red);color:#fff;border:3px solid var(--rule);padding:8px 16px;transform:skewX(-8deg);box-shadow:3px 3px 0 var(--rule)}
.next span{display:inline-block;transform:skewX(8deg)}
.next:active{box-shadow:1px 1px 0 var(--rule);translate:2px 2px}

/* 目次・あとがき */
.toc{list-style:none;display:flex;flex-direction:column;max-height:50dvh;overflow-y:auto}
.toc button{display:flex;gap:10px;align-items:baseline;text-align:left;width:100%;padding:8px 0;font-size:14px;font-weight:700;border-bottom:2px dashed rgba(22,19,15,.25)}
.toc button span{font-family:var(--head);font-size:12px;min-width:44px;color:var(--accent)}
.rules{list-style:none;display:flex;flex-direction:column;gap:9px;font-size:14px;line-height:1.75;font-weight:500}
.rules{counter-reset:r;max-height:52dvh;overflow-y:auto}
.rules li{padding-left:28px;position:relative;counter-increment:r}
.rules li::before{content:counter(r);position:absolute;left:0;top:2px;width:20px;height:20px;display:grid;place-items:center;background:var(--accent);color:#fff;border:2px solid var(--rule);font-family:var(--head);font-size:11px}

.toast{position:fixed;left:50%;bottom:84px;transform:translateX(-50%);background:var(--ink);color:var(--paper2);font-size:13px;font-weight:700;padding:8px 14px;border-radius:99px;opacity:0;transition:opacity .2s;z-index:30;pointer-events:none}
.toast.on{opacity:1}

@media (min-width:900px){.card{padding-left:12vw;padding-right:12vw}}
@media (prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style>
</head>
<body>
<header>
  <div class="mast">
