];
const EDITOR_NOTE = "見解は別々の媒体や発信者から、見る角度の違うものを原則2件。確認できない場合は無理に増やさない。各記事は速報性のある要約です。正確な内容は必ず出典で確かめてください。記事の選定・要約・解説は、AI（Anthropic社のClaude）が出典を確認しながら編集しています。誤りに気づいたら出典を優先してください。";
const VOICE_NOTE = "見解は発言や分析の要約です。「当事者の声」は関係者・会社の説明、「現場の声」はクレジットのある業界人の発信、「専門家の見解」は専門家本人、「分析・データ」は機関や媒体の分析、「反響」は視聴者の反応です。";

/* ===== 以下は描画（毎日変えない） ===== */
const CATS = {news:["業界ニュース","--red"], work:["新作・作品","--blue"], voice:["現場の声","--pink"]};
const $ = s => document.querySelector(s);
const feed = $("#feed");
const pad = n => String(n).padStart(2,"0");
const esc = s => String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const plain = s => s.replace(/<[^>]+>/g,"");
const srcHtml = arr => arr.map(([n,u,d]) => `<a href="${u}" target="_blank" rel="noopener">${esc(n)}</a>${d?"・"+esc(d):""}`).join("　");

(function(){
  const dt = new Date(ISSUE.date+"T12:00:00+09:00");
  const w = "日月火水木金土"[dt.getDay()];
  const [, m, d] = ISSUE.date.split("-").map(Number);
  $("#gou").textContent = `${m}.${d}(${w})号`;
})();

function rulesText(){
  const c = {news:0, work:0, voice:0};
  ISSUE.items.forEach(it=>c[it.cat]++);
  const label = o => `業界ニュース${o.news}・新作・作品${o.work}・現場の声${o.voice}`;
  const t = {news:Math.round(TARGET*MIX.news), work:Math.round(TARGET*MIX.work)};
  t.voice = TARGET - t.news - t.work;
  const map = {range:ISSUE.range, fresh:ISSUE.freshnessNote||"ほぼすべてが直近24時間の情報", target:TARGET, targetMix:label(t), n:ISSUE.items.length, mix:label(c)};
  return RULES.map(r=>r.replace(/\{(\w+)\}/g,(_,k)=>map[k]));
}

function render(){
  let html = "";
  ISSUE.items.forEach((it,i)=>{
    const n = i+1, color = CATS[it.cat][1];
    const k = [];
    k.push(`<article class="koma cover"><div class="ep">第${pad(n)}話<small>／全${ISSUE.items.length}話</small></div><div class="inner">
      <span class="stamp">${CATS[it.cat][0]}</span>
      <h2>${it.title}</h2>
      <div class="meta"><span>${esc(it.area)}</span><span>約${it.sec}秒で読める</span></div>
      <p class="lead">${esc(it.lead)}</p>
      <p class="src">出典：${srcHtml(it.src)}</p>
      ${(it.gist||it.details.length||it.voices.length)?'<p class="turn">横にめくると、くわしく</p>':""}
    </div></article>`);
    if(it.gist) k.push(`<article class="koma"><div class="inner"><p class="label">ざっくり言うと</p><p class="narr">${esc(it.gist)}</p></div></article>`);
    it.details.forEach((d,j)=>{
      const last = j===it.details.length-1 && it.dsrc;
      k.push(`<article class="koma"><div class="inner"><p class="label">くわしい話 ${j+1}</p><p class="ptext">${esc(d)}</p>${last?`<p class="src">出典：${srcHtml(it.dsrc)}</p>`:""}</div></article>`);
    });
    it.voices.forEach((v,j)=>{
      const last = j===it.voices.length-1;
      const few = last && it.voices.length<2 ? "別の媒体や発信者で確認できた見解は1件だけのため、無理に増やしていません。" : "";
      k.push(`<article class="koma"><div class="inner"><p class="label">${esc(v.kind)}　${j+1} / ${it.voices.length}</p>
        <div class="bubble"><b>「${esc(v.head)}」</b>${esc(v.text)}</div>
        <div class="speaker"><span class="face">${esc(v.who.slice(0,1))}</span><div><strong>${esc(v.who)}</strong><span>${esc(v.role)}</span></div></div>
        ${v.src?`<p class="src">出典：${srcHtml(v.src)}</p>`:""}
        ${last?`<p class="note">${VOICE_NOTE}${few}</p>`:""}</div></article>`);
    });
    html += `<section class="card" id="n${pad(n)}" data-cat="${it.cat}" style="--accent:var(${color})" aria-label="${esc(plain(it.title))}">
      <div class="panels">${k.join("")}</div>
      ${k.length>1?`<div class="pages" aria-hidden="true">${k.map((_,j)=>`<i class="${j?"":"on"}"></i>`).join("")}</div>`:""}
      <button class="share" data-share="n${pad(n)}">この話をシェア</button>
    </section>`;
  });
  html += `<section class="card" id="end" data-cat="all" style="--accent:var(--red)">
    <div class="panels">
      <article class="koma"><div class="ep">今回の話数一覧</div><div class="inner" style="margin-top:28px">
        <ul class="toc">${ISSUE.items.map((it,i)=>`<li><button data-go="n${pad(i+1)}"><span>第${pad(i+1)}話</span>${esc(plain(it.title))}</button></li>`).join("")}</ul>
        <p class="turn">横にめくると、選び方</p></div></article>
      <article class="koma"><div class="ep">あとがき（選び方）</div><div class="inner" style="margin-top:28px">
        <ol class="rules">${rulesText().map(r=>`<li>${esc(r)}</li>`).join("")}</ol>
        <p class="note">${EDITOR_NOTE}</p></div></article>
    </div>
  </section>`;
  feed.innerHTML = html;
}
render();

/* ===== カテゴリのタブ ===== */
function renderTabs(active){
  const counts = {all:ISSUE.items.length};
  ISSUE.items.forEach(it=>counts[it.cat]=(counts[it.cat]||0)+1);
  const list = [["all","ぜんぶ"],...Object.entries(CATS).map(([k,v])=>[k,v[0]])];
  $("#tabs").innerHTML = list.filter(([k])=>counts[k]).map(([k,l])=>`<button data-cat="${k}" aria-pressed="${k===active}">${l}<i>${counts[k]}</i></button>`).join("");
}
renderTabs("all");
$("#tabs").addEventListener("click",e=>{
  const b = e.target.closest("button"); if(!b) return;
  const c = b.dataset.cat;
  renderTabs(c);
  feed.querySelectorAll(".card").forEach(s=>{ s.hidden = !(c==="all" || s.dataset.cat===c || s.id==="end"); });
  feed.scrollTo({top:0});
  current = feed.querySelector(".card:not([hidden])");
  updateCount();
});

/* ===== 話数カウンタ ===== */
let current = null;
const storyCards = () => [...feed.querySelectorAll(".card:not([hidden]):not(#end)")];
function updateCount(){
  const vs = storyCards();
  $("#tot").textContent = vs.length;
  const atEnd = current && current.id==="end";
  $("#cur").textContent = atEnd ? vs.length : Math.max(1, vs.indexOf(current)+1);
  $("#nextLabel").textContent = atEnd ? "第1話にもどる ▲" : "次の話へ ▼";
}
/* プレビュー環境などでは履歴の書き換えができないので、失敗しても止めない */
function setHash(id){ try{ history.replaceState(null,"","#"+id); }catch(_){} }
const io = new IntersectionObserver(es=>{
  es.forEach(e=>{ if(e.isIntersecting){ current=e.target; updateCount(); if(current.id!=="end") setHash(current.id); } });
},{root:feed,threshold:.6});
feed.querySelectorAll(".card").forEach(c=>io.observe(c));

$("#nextBtn").addEventListener("click",()=>{
  const all = [...feed.querySelectorAll(".card:not([hidden])")];
  const i = all.indexOf(current);
  const target = (current && current.id==="end") ? all[0] : all[Math.min(i+1, all.length-1)];
  target.scrollIntoView({behavior:"smooth"});
});

/* ===== コマ送りの印 ===== */
feed.querySelectorAll(".card").forEach(card=>{
  const p = card.querySelector(".panels"), dots = card.querySelectorAll(".pages i");
  if(!dots.length) return;
  p.addEventListener("scroll",()=>{
    const k = Math.round(p.scrollLeft / (p.scrollWidth / dots.length));
    dots.forEach((d,j)=>d.classList.toggle("on", j===k));
  },{passive:true});
});

/* ===== シェア・目次・選び方 ===== */
function toast(msg){ const t=$("#toast"); t.textContent=msg; t.classList.add("on"); setTimeout(()=>t.classList.remove("on"),1800); }
function pageUrl(){ const u = location.href.split("#")[0]; return /^https?:/.test(u) ? u : ""; }
document.addEventListener("click",async e=>{
  const s = e.target.closest("[data-share]");
  if(s){
    const base = pageUrl();
    if(!base){ toast("公開後のページでシェアできます"); return; }
    const url = base+"#"+s.dataset.share, title = s.closest(".card").getAttribute("aria-label");
    try{
      if(navigator.share){ await navigator.share({title, url}); }
      else { await navigator.clipboard.writeText(url); toast("リンクをコピーしました"); }
    }catch(_){ /* キャンセル時は何もしない */ }
  }
  const g = e.target.closest("[data-go]");
  if(g) document.getElementById(g.dataset.go).scrollIntoView({behavior:"smooth"});
});
$("#howBtn").addEventListener("click",()=>{
  const end = $("#end"); end.scrollIntoView({behavior:"smooth"});
  setTimeout(()=>{ const p=end.querySelector(".panels"); p.scrollTo({left:p.scrollWidth,behavior:"smooth"}); },450);
});

/* #n03 などのリンクで開いたとき */
if(location.hash){ const t=document.getElementById(location.hash.slice(1)); if(t) t.scrollIntoView(); }
</script>
</body>
</html>
